[Unit]
Description=Cave init (create keycloak DB)
After=cave-pg.service
Requires=cave-pg.service
Before=cave-keycloak.service

[Container]
ContainerName=cave-prod-init
Image=docker.io/postgres:16-alpine
Network=cave.network
Exec=sh -c 'until pg_isready -h cave-prod-pg -U cave; do sleep 1; done; psql -h cave-prod-pg -U cave -tc "SELECT 1 FROM pg_database WHERE datname='"'"'keycloak'"'"'" | grep -q 1 || psql -h cave-prod-pg -U cave -c "CREATE DATABASE keycloak"; echo done'
Environment=PGPASSWORD=cave

[Service]
Type=oneshot
RemainAfterExit=false
