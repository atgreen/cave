<html>
<body style="margin:0;padding:0;background:#131216;font-family:'IBM Plex Sans',-apple-system,BlinkMacSystemFont,sans-serif">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#131216;padding:40px 20px">
<tr><td align="center">
<table width="520" cellpadding="0" cellspacing="0" style="background:#1e1d23;border:1px solid #2e2d35;border-radius:3px">
  <tr>
    <td style="padding:24px 32px 16px;font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:700;color:#e8a84c;letter-spacing:0.06em;text-transform:uppercase">
      CAVE
    </td>
  </tr>
  <tr>
    <td style="padding:0 32px 8px;font-family:'IBM Plex Mono',monospace;font-size:16px;font-weight:600;color:#d4d0c8">
      Reset your password
    </td>
  </tr>
  <tr>
    <td style="padding:0 32px 24px;font-size:14px;color:#9e9a8f;line-height:1.6">
      Someone requested a password reset for your Cave account.
      If this was you, click the link below.
    </td>
  </tr>
  <tr>
    <td style="padding:0 32px 24px">
      <a href="${link}" style="display:inline-block;padding:8px 20px;background:#c4893a;color:#131216;font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:500;border-radius:3px;text-decoration:none">
        Reset password
      </a>
    </td>
  </tr>
  <tr>
    <td style="padding:0 32px 24px;font-size:12px;color:#6e6b63;line-height:1.5">
      This link will expire in ${linkExpirationFormatter(linkExpiration)}.
      If you didn't request a password reset, you can ignore this email.
    </td>
  </tr>
</table>
</td></tr>
</table>
</body>
</html>
